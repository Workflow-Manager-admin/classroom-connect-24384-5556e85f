{
  "task_description": "{'component_name': 'Main Container for Classroom Connect', 'description': 'Primary container for Classroom Connect implementation: Classroom Insider is an informal, student-friendly collaboration app for classrooms. Users securely sign up and join classrooms via unique codes. Each classroom offers public chat, a bulletin board for reminders, a notebook for organized notes and file uploads, group project management with team formation and task tracking, and integrated video/audio calls. The app emphasizes ease of use, informality, and a welcoming digital classroom vibe.', 'framework': 'fastapi', 'platform': 'web', 'container': '{\n  "name": "ColorCraft backend Container",\n  "features": [\n    {\n      "name": "Secure Authentication",\n      "description": "Users sign up, log in, and maintain a unique user ID using a production-ready authentication API (e.g., Firebase Auth, Supabase Auth, or Auth0).",\n      "isEnabled": true\n    },\n    {\n      "name": "Classroom Creation & Joining",\n      "description": "Users can create classrooms with a unique 6-digit alphanumeric code. Anyone with the code can join. Users can join multiple classrooms. No host privileges.",\n      "isEnabled": true\n    },\n    {\n      "name": "Public Chat",\n      "description": "Each classroom has a public chat visible to all members. No private DMs are allowed.",\n      "isEnabled": true\n    },\n    {\n      "name": "Bulletin Board",\n      "description": "A shared space for all users to post reminders, announcements, and tasks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Notebook with File Uploads",\n      "description": "Users can upload and organize notes by subject, with each subject having its own section. Supports file uploads (PDFs, images, etc.).",\n      "isEnabled": true\n    },\n    {\n      "name": "Group Project Management",\n      "description": "Users select subject and team size, form teams randomly or by self-selection, elect a leader, and manage tasks with a progress bar.",\n      "isEnabled": true\n    },\n    {\n      "name": "Video & Audio Calls",\n      "description": "Enable classroom-wide or group project calls (video/audio) for discussions.",\n      "isEnabled": true\n    },\n    {\n      "name": "User Dashboard",\n      "description": "Each user has a dashboard showing all classrooms they are part of.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "None"\n    ],\n    "backend": [\n      "FastAPI"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#4F8CFF",\n    "secondary": "#FFE066",\n    "accent": "#FF6F61"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI features a welcoming, informal dashboard with a list of joined classrooms. Each classroom opens to a tabbed interface: Chat, Bulletin Board, Notebook, Group Projects, and Calls. Bright, playful colors and rounded elements create a casual, student-friendly vibe. Navigation is simple, with floating action buttons for quick actions (e.g., join/create classroom, add note, start call)."\n}'}",
